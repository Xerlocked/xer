---
import type { MarkdownHeading } from "astro"

type Props = {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
const sections: { heading: MarkdownHeading; children: MarkdownHeading[] }[] = []

for (const heading of headings) {
  const section = sections[sections.length - 1]
  if (section && heading.depth > section.heading.depth) {
    section.children.push(heading)
  } else {
    sections.push({ heading, children: [] })
  }
}
---

<ul class="space-y-1">
  {sections.map(({ heading, children }) => (
    <li>
      <a
        href={`#${encodeURIComponent(heading.slug)}`}
        class="block rounded-sm py-1.5 [overflow-wrap:anywhere] text-muted-foreground hover:text-foreground hover:underline underline-offset-4"
      >
        {heading.text}
      </a>
      {children.length > 0 && (
        <div class="ml-3 border-l border-border pl-3 sm:ml-4">
          <Astro.self headings={children} />
        </div>
      )}
    </li>
  ))}
</ul>
