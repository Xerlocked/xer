---
import type { MarkdownHeading } from "astro"
import TableOfContentsList from "@components/TableOfContentsList.astro"

type Props = {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props
---

{
  headings.length > 0 && (
    <nav aria-label="목차" class="mb-8 rounded-lg border border-border bg-muted/40 px-5">
      <details open class="group/toc">
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 rounded-md py-4 text-sm font-semibold text-foreground [&::-webkit-details-marker]:hidden">
          <span>목차</span>
          <svg aria-hidden="true" class="size-4 shrink-0 text-muted-foreground group-open/toc:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="border-t border-border pt-3 pb-5 text-sm leading-relaxed">
          <TableOfContentsList headings={headings} />
        </div>
      </details>
    </nav>
  )
}
