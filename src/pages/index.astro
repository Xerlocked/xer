---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import ChaseGame from "@components/ChaseGame";
import { SITE } from "@consts";

const files = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .map((post) => ({
    id: post.id,
    title: post.data.title,
    summary: post.data.summary,
    href: `/blog/${post.id}`,
  }));
---

<PageLayout title="홈" description={SITE.DESCRIPTION}>
  <section class="landing" aria-label="Xerlock">
    <ChaseGame files={files} client:visible />
    <noscript><p class="landing-fallback">게임은 JavaScript를 켜면 즐길 수 있습니다. <a href="/blog">블로그</a>와 <a href="/projects">프로젝트</a>는 메뉴에서 살펴보세요.</p></noscript>
  </section>
</PageLayout>

<style>
  .landing { width: 100%; max-width: 1040px; margin: auto; padding: 96px 24px 24px; min-height: calc(100svh - 184px); display: flex; flex-direction: column; justify-content: center; }
  .landing-fallback { margin-top: 12px; text-align: center; font-size: 13px; }
  .landing-fallback a { text-decoration: underline; }
  @media (max-width: 600px) {
    .landing { padding: 88px 20px 20px; }
  }
</style>
