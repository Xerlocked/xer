---
import { type CollectionEntry, getCollection, render } from "astro:content"
import TableOfContents from "@components/TableOfContents.astro"
import SeriesNavigation from "@components/SeriesNavigation.astro"
import GiscusComments from "@components/GiscusComments.astro"
import { getSeriesPosts } from "@lib/series"

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">
}

// Get the requested entry
const { entry } = Astro.props
const { collection } = entry
const { Content, headings } = await render(entry)

const series = entry.collection === "blog" ? entry.data.series : undefined
const seriesPosts = series ? getSeriesPosts(await getCollection("blog"), series) : []
// Series follow reading order without wrapping; other entries retain date order.
const items = series ? seriesPosts : (await getCollection(collection))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
const index = items.findIndex(x => x.id === entry.id)
const prev = series ? (index > 0 ? items[index - 1] : undefined) : items[(index - 1 + items.length) % items.length]
const next = series ? (index >= 0 ? items[index + 1] : undefined) : items[(index + 1) % items.length]
---

<div>
  {series && seriesPosts.length > 0 && <SeriesNavigation name={series} posts={seriesPosts} currentId={entry.id} />}
  {collection === "blog" && <TableOfContents headings={headings} />}
  <article class:list={[{ "blog-content": collection === "blog" }]}>
    <Content/>
  </article>
  {collection === "blog" && <GiscusComments />}
  {(prev || next) && <nav aria-label={series ? "시리즈 이전·다음 편" : "이전·다음 글"} class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {prev && <a href={`/${prev.collection}/${prev.id}`} class="ui-card group p-5 gap-3 flex items-center">
      <div class="order-2 w-full h-full group-hover:text-foreground blend">
        <div class="flex flex-wrap gap-2">
          <div class="text-sm uppercase">
            {series ? "이전 편" : "Prev"}
          </div>
        </div>
        <div class="font-semibold mt-3 text-foreground">
          {prev.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="order-1 stroke-current group-hover:stroke-foreground rotate-180">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-transform duration-150" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-transform duration-150" />
      </svg>
    </a>}
    {next && <a href={`/${next.collection}/${next.id}`} class="ui-card group p-5 gap-3 flex items-center sm:col-start-2">
      <div class="w-full h-full text-right group-hover:text-foreground blend">
        <div class="text-sm uppercase">
          {series ? "다음 편" : "Next"}
        </div>
        <div class="font-semibold mt-3 text-foreground">
          {next.data.title}
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-foreground">
        <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-transform duration-150" />
        <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-transform duration-150" />
      </svg>
    </a>}
  </nav>}
</div>

<style>
  .blog-content :global(:is(h1, h2, h3, h4, h5, h6)[id]) {
    scroll-margin-top: 6rem;
  }
</style>
