---
import type { CollectionEntry } from "astro:content";
import { formatDate, readingTime } from "@lib/utils";
import { categoryHref } from "@lib/categories";

type Props = {
  entry: CollectionEntry<"projects"> | CollectionEntry<"blog">;
};

const { entry } = Astro.props;
const { collection, data, body } = entry;
const { title, summary, date } = data;

const demoUrl = collection === "projects" ? data.demoUrl : null;
const repoUrl = collection === "projects" ? data.repoUrl : null;
---

<div>
  <a
    href={`/${collection}`}
    class="ui-button group w-fit"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="stroke-current group-hover:stroke-foreground"
    >
      <line
        x1="19"
        y1="12"
        x2="5"
        y2="12"
        class="scale-x-0 group-hover:scale-x-100 translate-x-3 group-hover:translate-x-0 transition-transform duration-150"
      ></line>
      <polyline
        points="12 19 5 12 12 5"
        class="translate-x-1 group-hover:translate-x-0 transition-transform duration-150"
      ></polyline>
    </svg>
    <div
      class="w-full group-hover:text-foreground transition-colors duration-150"
    >
      Back to {collection}
    </div>
  </a>
  <div class="flex flex-wrap text-sm text-muted-foreground mt-10 gap-4 tabular-nums">
    {entry.collection === "blog" && (
      <a href={categoryHref(entry.data.Category)} class="ui-badge hover:bg-accent" aria-label={`${entry.data.Category} 카테고리 글 보기`}>{entry.data.Category}</a>
    )}
    <div class="flex items-center gap-2">
      <svg class="size-5 stroke-current">
        <use href="/ui.svg#calendar"></use>
      </svg>
      {formatDate(date)}
    </div>
    <div class="flex items-center gap-2">
      <svg class="size-5 stroke-current">
        <use href="/ui.svg#book-open"></use>
      </svg>
      {readingTime(body ?? "")}
    </div>
  </div>
  <h1 class="text-3xl font-semibold text-foreground mt-2">
    {title}
  </h1>
  <div class="mt-1">
    {summary}
  </div>
  {
    data.image && (
      <div class="w-full mt-8 overflow-hidden rounded-xl border border-border">
        <img
          src={data.image.src}
          alt={title}
          class="w-full h-auto object-cover"
        />
      </div>
    )
  }
  {
    (demoUrl || repoUrl) && (
      <div class="mt-4 flex flex-wrap gap-2">
        {demoUrl && (
          <a
            href={demoUrl}
            target="_blank"
            class="ui-button group"
          >
            <svg class="size-4">
              <use
                href="/ui.svg#globe"
                class="fill-current group-hover:fill-foreground blend"
              />
            </svg>
            <span class="text-current group-hover:text-foreground blend">
              See Demo
            </span>
          </a>
        )}
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            class="ui-button group"
          >
            <svg class="size-4">
              <use
                href="/ui.svg#link"
                class="fill-current group-hover:fill-foreground blend"
              />
            </svg>
            <span class="text-current group-hover:text-foreground blend">
              See Repository
            </span>
          </a>
        )}
      </div>
    )
  }
</div>
